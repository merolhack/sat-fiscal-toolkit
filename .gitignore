# 1. ARCHIVOS CONFIDENCIALES DE FACTURACIÓN Y CFDI
# Previene la subida de facturas reales, complementos y papeles de trabajo
*.xml
*.XML
*.pdf
*.PDF
*.json
*.JSON
*.csv
*.xlsx
*.xls
*.zip
*.ZIP

# Conservar la estructura de carpetas de datos con .gitkeep
data/**
!data/**/
!data/**/.gitkeep

# 2. CERTIFICADOS, LLAVES Y CREDENCIALES (e.firma / SAT)
# ¡NUNCA SUBIR LLAVES PRIVADAS NI CERTIFICADOS AL REPOSITORIO!
*.key
*.KEY
*.cer
*.CER
*.pfx
*.p12
*.req
*.pem
.env
.env.*
.envrc
secrets.json
*.secrets.*
.streamlit/secrets.toml

# 3. ENTORNOS VIRTUALES DE PYTHON
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

